---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

const testimonials = [
  {
    quote: "Un cadre XVIIIe restauré avec une précision et une sensibilité rares. La dorure à la feuille est parfaitement intégrée — on ne voit pas l'intervention.",
    author: "M. Lefebvre",
    detail: "Particulier, Paris 7e"
  },
  {
    quote: "Sophie a restauré quatre fauteuils Louis XV pour notre hôtel. Résultat impeccable, délais respectés, interlocutrice passionnée.",
    author: "Direction artistique",
    detail: "Hôtel particulier, Paris 8e"
  },
  {
    quote: "Notre retable du XVIIe était dans un état critique. L'atelier a réalisé un travail de conservation exemplaire, validé par notre DRAC.",
    author: "Père D.",
    detail: "Paroisse, Paris 14e"
  },
];
---

<Layout
  title="Restauration Dorures Paris 14 — Atelier La Toison d'Or"
  description="Atelier de restauration et conservation des dorures anciennes à Paris 14e depuis 1990. Cadres, mobilier, objets d'art, monuments historiques. Sur rendez-vous."
  canonical="/"
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-anthracite">
    <div class="absolute inset-0 bg-anthracite/60 z-10"></div>
    <div
      class="absolute inset-0 bg-cover bg-center z-0"
      style="background-image: url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1920&q=80&auto=format&fit=crop')"
      aria-hidden="true"
    ></div>

    <div class="relative z-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <p class="font-sans text-xs uppercase tracking-widest text-terracotta mb-4">
        Atelier dorures · Paris 14<sup>e</sup> · Depuis 1990
      </p>
      <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl text-creme leading-tight max-w-2xl mb-6">
        L'or retrouve sa lumière.
      </h1>
      <p class="font-sans text-lin/80 text-lg max-w-lg mb-10 leading-relaxed">
        Restauration et conservation des dorures anciennes — cadres, mobilier, objets d'art et monuments historiques — selon les méthodes traditionnelles.
      </p>
      <a href="/contact" class="btn-primary text-base px-8 py-4">
        Prendre rendez-vous
      </a>
    </div>
  </section>

  <!-- Bandeau réassurance -->
  <section class="bg-lin py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { value: '35+', label: "années d'expérience" },
          { value: 'Depuis 1990', label: 'dans le 14e' },
          { value: '100%', label: 'méthodes traditionnelles' },
          { value: 'Privés & MH', label: 'monuments historiques' },
        ].map(item => (
          <div class="fade-up">
            <p class="font-serif text-4xl text-terracotta mb-1">{item.value}</p>
            <p class="font-sans text-xs uppercase tracking-wide text-anthracite/70">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Aperçu prestations -->
  <section class="py-20 bg-creme">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="section-subtitle">Ce que nous faisons</p>
        <h2 class="section-title max-w-xl">
          Un atelier pour les œuvres auxquelles vous tenez.
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: '🖼',
            title: 'Cadres & boiseries dorés',
            desc: "Restauration de cadres anciens, boiseries et miroirs encadrés — dorure à la feuille, brunissage, repeints.",
          },
          {
            icon: '🪑',
            title: 'Mobilier doré',
            desc: "Fauteuils, consoles, lits de parade et sièges d'époque. Chaque pièce est traitée selon son état et son ancienneté.",
          },
          {
            icon: '⛪',
            title: 'Monuments historiques',
            desc: 'Intervention sur retables, autels, boiseries liturgiques et objets de culte. Travaux agréés DRAC.',
          },
          {
            icon: '🏛',
            title: 'Objets d\'art & bronzes',
            desc: "Restauration d'objets précieux, bronzes dorés, lustres et chandeliers anciens.",
          },
          {
            icon: '🔬',
            title: 'Conservation préventive',
            desc: "Diagnostic, consolidation des surfaces fragilisées et traitement de conservation pour prévenir toute dégradation.",
          },
          {
            icon: '📅',
            title: 'Formation à la dorure',
            desc: 'Cours et stages pour particuliers ou professionnels souhaitant apprendre les techniques de dorure traditionnelle.',
          },
        ].map(item => (
          <div class="bg-lin/30 border border-lin p-6 rounded-sm fade-up group hover:border-terracotta/40 transition-colors">
            <span class="text-2xl mb-4 block" aria-hidden="true">{item.icon}</span>
            <h3 class="font-serif text-xl text-anthracite mb-2">{item.title}</h3>
            <p class="font-sans text-sm text-anthracite/70 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/services" class="btn-outline">Voir toutes nos prestations</a>
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="py-20 bg-lin/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="section-subtitle">Ce qu'ils en disent</p>
        <h2 class="section-title">Ce que disent nos clients.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <TestimonialCard quote={t.quote} author={t.author} detail={t.detail} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="bg-terracotta py-16">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="font-serif text-3xl md:text-4xl text-creme mb-4">
        Prêt à confier votre œuvre ?
      </h2>
      <p class="font-sans text-lin/80 mb-8 leading-relaxed">
        Contactez-nous pour un premier diagnostic — examen et devis offerts.
      </p>
      <a href="/contact" class="inline-block bg-creme text-terracotta font-medium px-8 py-4 rounded-sm hover:bg-lin transition-colors">
        Prendre rendez-vous
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
