---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';

const services = [
  {
    category: 'Restauration de cadres & boiseries',
    items: [
      {
        title: 'Cadres anciens dorés',
        description: "Restauration complète de cadres anciens : consolidation du bois, restitution des ornements manquants, dorure à la feuille d'or sur bol d'Arménie.",
        priceRange: 'sur devis',
        examples: ['Cadres XVIIe – XIXe siècle', 'Cadres de tableaux de maître', 'Cadres de miroirs anciens'],
      },
      {
        title: 'Boiseries & lambris dorés',
        description: "Restauration de boiseries architecturales, lambris, trumeau et encadrements de portes dorés à la feuille ou à la mixtion.",
        priceRange: 'sur devis',
        examples: ['Salons XVIIIe', 'Bibliothèques et cabinets', 'Boiseries de chapelles'],
      },
      {
        title: 'Miroirs & trumeaux',
        description: "Remise en état de la dorure autour des miroirs anciens — repeints, brunissage et patinage selon l'époque.",
        priceRange: 'sur devis',
        examples: ['Trumeaux Régence et Louis XV', 'Miroirs Empire', 'Psychés et miroirs de cheminée'],
      },
    ],
  },
  {
    category: 'Restauration de mobilier doré',
    items: [
      {
        title: 'Sièges & fauteuils d\'époque',
        description: "Restauration de la dorure sur fauteuils, canapés, chaises et tabourets — traitement du bois, restitution des profils sculptés, dorure à la feuille.",
        priceRange: 'sur devis',
        examples: ['Fauteuils Louis XV et Louis XVI', 'Sièges Empire et Restauration', 'Banquettes et tabourets dorés'],
      },
      {
        title: 'Commodes, consoles & bureaux',
        description: "Intervention sur les parties dorées de meubles de rangement et meubles d'appui — montants, sabots, frises et bronzes appliqués.",
        priceRange: 'sur devis',
        examples: ['Commodes estampillées', 'Consoles dorées', 'Bureaux à cylindre'],
      },
      {
        title: 'Lits de parade & mobilier de cérémonie',
        description: "Restauration de lits à baldaquin, berceaux et mobilier de cérémonie — dorure et conservation des textiles associés.",
        priceRange: 'sur devis',
        examples: ['Lits XVIIe – XVIIIe', 'Berceaux princiers', 'Trônes et chaises de cérémonie'],
      },
    ],
  },
  {
    category: 'Objets d\'art & monuments historiques',
    items: [
      {
        title: 'Objets d\'art & bronzes dorés',
        description: "Restauration de bronzes dorés au feu ou à la feuille, lustres, candélabres, statuettes et objets précieux.",
        priceRange: 'sur devis',
        examples: ['Lustres et candélabres', 'Bronzes Empire', 'Pendules et garnitures de cheminée'],
      },
      {
        title: 'Oeuvres religieuses & retables',
        description: "Restauration de retables, autels dorés, boiseries liturgiques et objets de culte. Travaux réalisés en lien avec les DRAC et services des monuments historiques.",
        priceRange: 'sur devis',
        examples: ['Retables et autels', 'Baldaquins et tabernacles', 'Statues et bas-reliefs dorés'],
      },
    ],
  },
  {
    category: 'Conservation & formation',
    items: [
      {
        title: 'Diagnostic & conservation préventive',
        description: "Examen de l'état de conservation, rapport écrit, consolidation préventive et recommandations pour préserver vos œuvres dans la durée.",
        priceRange: 'sur devis',
        examples: ['Rapport d\'état', 'Consolidation de surfaces', 'Conseils de conservation'],
      },
      {
        title: 'Formation à la dorure',
        description: "Cours et stages individuels ou en petit groupe pour apprendre les techniques de dorure à la feuille, au tampon et à la mixtion.",
        priceRange: 'sur devis',
        examples: ['Initiation dorure à la feuille', 'Stage patinage et brunissage', 'Formation professionnalisante'],
      },
    ],
  },
];
---

<Layout
  title="Prestations — Restauration Dorures Paris 14 · Atelier La Toison d'Or"
  description="Restauration de cadres, mobilier, objets d'art et monuments historiques à Paris 14e. Dorure à la feuille, conservation, formation. Devis gratuit sur rendez-vous."
  canonical="/services"
>
  <Header slot="header" />

  <!-- Page header -->
  <section class="page-hero">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="page-kicker">Nos prestations</p>
      <h1 class="page-title mb-5">
        Restauration et conservation des dorures anciennes à Paris 14<sup class="text-lg">e</sup>.
      </h1>
      <p class="page-lede">
        Chaque intervention est précédée d'un examen de l'état de conservation. Le devis est établi sur rendez-vous, après diagnostic de la pièce, et sans engagement.
      </p>
    </div>
  </section>

  <!-- Services par catégorie -->
  <section class="section-band bg-creme">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14 md:space-y-20">
      {services.map(cat => (
        <div>
          <h2 class="section-heading mb-7 pb-4 border-b border-lin">
            {cat.category}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
            {cat.items.map(item => (
              <ServiceCard
                title={item.title}
                description={item.description}
                priceRange={item.priceRange}
                examples={item.examples}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Note tarifaire + CTA -->
  <section class="bg-lin py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="font-serif text-2xl md:text-3xl font-medium italic text-anthracite leading-tight mb-7">
        « Un devis précis nécessite de voir l'œuvre. Venez avec votre pièce — le diagnostic est offert. »
      </p>
      <a href="/contact" class="btn-primary">Prendre rendez-vous</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
