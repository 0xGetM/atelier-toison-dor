---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQItem from '../components/FAQItem.astro';

const faq = [
  {
    question: 'Sur quels types d\'objets intervenez-vous ?',
    answer: "Nous restaurons les dorures anciennes sur cadres, boiseries, mobilier (fauteuils, consoles, commodes, lits de parade), objets d'art (bronzes, lustres, candélabres), et éléments architecturaux. Nous intervenons aussi sur des œuvres religieuses et des éléments de monuments historiques, en lien avec les services de la DRAC si nécessaire.",
    open: true,
  },
  {
    question: "Quelles techniques de dorure utilisez-vous ?",
    answer: "Nous utilisons exclusivement les techniques traditionnelles : dorure à la feuille sur bol d'Arménie (pour les surfaces brunissables), dorure à la mixtion (pour les surfaces mates ou extérieures), et dorure au tampon. Les matériaux employés — feuille d'or véritable, bol naturel, colles de peau — sont ceux que les doreurs d'époque auraient utilisés.",
  },
  {
    question: 'Comment se déroule une restauration ?',
    answer: "Tout commence par un diagnostic en atelier ou sur site : examen de l'état de conservation, identification des couches et des matériaux d'origine. Un rapport d'état et un devis écrit vous sont remis avant tout travail. La restauration est ensuite réalisée par étapes — consolidation, complétion des manques, dorure, patinage — et vous êtes informé à chaque phase.",
  },
  {
    question: 'Comment sont établis vos tarifs ?',
    answer: "Tous nos travaux sont réalisés sur devis, établi après examen de la pièce. Le prix dépend de l'état de conservation, des dimensions, de la complexité des ornements et de la technique de dorure appropriée. Aucun travail ne commence sans votre accord explicite et signé sur le devis.",
  },
  {
    question: 'Acceptez-vous les œuvres de monuments historiques ?',
    answer: "Oui. L'atelier intervient sur des œuvres et éléments classés ou inscrits aux monuments historiques. Ces travaux sont réalisés dans le respect des prescriptions de la DRAC et peuvent faire l'objet d'un rapport de restauration complet. Nous collaborons avec des conservateurs et des maîtres d'œuvre du patrimoine.",
  },
  {
    question: 'Proposez-vous des formations à la dorure ?',
    answer: "Oui. Sophie Derouin dispense des cours et stages de dorure à la feuille pour les particuliers et les professionnels (artisans, restaurateurs, décorateurs). Les sessions sont organisées en petit groupe ou en individuel. Contactez-nous pour connaître les prochaines dates et les programmes disponibles.",
  },
  {
    question: 'Faut-il apporter l\'objet à l\'atelier ?',
    answer: "Pour les petits et moyens objets, nous vous demandons de les apporter à l'atelier, 20 rue Ernest Cresson, Paris 14e. Pour les pièces imposantes (grandes boiseries, mobilier fixe, éléments architecturaux), nous pouvons nous déplacer sur site en Île-de-France. Contactez-nous pour convenir des modalités.",
  },
  {
    question: 'Quels sont vos délais habituels ?',
    answer: "Les délais varient selon la nature et l'état de la pièce. Un cadre de taille standard peut être rendu sous 3 à 6 semaines. Un fauteuil ou un ensemble de boiseries demandera davantage de temps. Un délai réaliste est toujours établi lors du devis — nous ne promettons pas ce que nous ne pouvons pas tenir.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<Layout
  title="FAQ — Questions fréquentes · Atelier La Toison d'Or Paris 14"
  description="Techniques de dorure, types d'objets restaurés, délais, monuments historiques, formations... Réponses aux questions fréquentes de l'atelier La Toison d'Or, Paris 14e."
  canonical="/faq"
  schema={faqSchema}
>
  <Header slot="header" />

  <!-- Page header -->
  <section class="bg-lin py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="section-subtitle">FAQ</p>
      <h1 class="section-title max-w-xl mb-4">
        Questions fréquentes.
      </h1>
      <p class="font-sans text-anthracite/70 max-w-lg leading-relaxed">
        Vous avez une question avant de nous contacter ? Les réponses les plus courantes sont là. Sinon, appelez-nous — nous sommes à votre écoute.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-creme">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {faq.map((item, i) => (
        <FAQItem question={item.question} answer={item.answer} open={i === 0} />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-lin py-12">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <p class="font-serif text-xl text-anthracite mb-4">
        Une question qui n'est pas dans la liste ?
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+33633791086" class="btn-outline">Nous appeler</a>
        <a href="/contact" class="btn-primary">Écrire un message</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
