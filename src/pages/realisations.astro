---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';

const UNS = 'https://images.unsplash.com';
const realisations = [
  {
    category: 'Cadre',
    before: `${UNS}/photo-1512436991641-6745cdb1723f?w=800&q=80&auto=format&fit=crop`,
    after:  `${UNS}/photo-1515886657613-9f3515b0c78f?w=800&q=80&auto=format&fit=crop`,
    beforeAlt: 'Cadre XVIIIe avant restauration — dorure oxydée et lacunes',
    afterAlt: 'Cadre XVIIIe après restauration — dorure à la feuille restituée',
    caption: "Cadre XVIIIe siècle — consolidation du bois, restitution des ornements, dorure à la feuille sur bol d'Arménie.",
  },
  {
    category: 'Mobilier',
    before: `${UNS}/photo-1523381210434-271e8be1f52b?w=800&q=80&auto=format&fit=crop`,
    after:  `${UNS}/photo-1509631179647-0177331693ae?w=800&q=80&auto=format&fit=crop`,
    beforeAlt: 'Fauteuil Louis XV avant restauration — dorure usée et bois fragilisé',
    afterAlt: 'Fauteuil Louis XV après restauration — dorure brunissée et patinée',
    caption: 'Fauteuil Louis XV — traitement du bois sculpté, restitution des manques, dorure à la feuille et brunissage.',
  },
  {
    category: 'Mobilier',
    before: `${UNS}/photo-1490481651871-ab68de25d43d?w=800&q=80&auto=format&fit=crop`,
    after:  `${UNS}/photo-1539109136881-3be0616acf4b?w=800&q=80&auto=format&fit=crop`,
    beforeAlt: 'Console Empire avant restauration — dorure altérée',
    afterAlt: 'Console Empire après restauration — dorure restituée à l\'identique',
    caption: 'Console Empire — nettoyage, consolidation, dorure à la mixtion et patinage d\'époque.',
  },
  {
    category: 'Objet d\'art',
    before: `${UNS}/photo-1576995853123-5a10305d93c0?w=800&q=80&auto=format&fit=crop`,
    after:  `${UNS}/photo-1542272604-787c3835535d?w=800&q=80&auto=format&fit=crop`,
    beforeAlt: 'Lustre bronze avant restauration — dorure noircie et pièces manquantes',
    afterAlt: 'Lustre bronze après restauration — dorure au feu restituée',
    caption: "Lustre bronze XVIIIe — restauration de la dorure au feu, remplacement des pièces manquantes, patine d'époque.",
  },
  {
    category: 'Cadre',
    before: `${UNS}/photo-1582552938357-32b906df40cb?w=800&q=80&auto=format&fit=crop`,
    after:  `${UNS}/photo-1475178626620-a4d074967452?w=800&q=80&auto=format&fit=crop`,
    beforeAlt: 'Cadre miroir avant restauration — lacunes importantes et bois vermoulu',
    afterAlt: 'Cadre miroir après restauration — dorure complète restituée',
    caption: "Cadre de miroir Régence — traitement du bois, reconstruction des profils en stuc, dorure à la feuille.",
  },
  {
    category: 'Monument',
    before: `${UNS}/photo-1496747611176-843222e1e57c?w=800&q=80&auto=format&fit=crop`,
    after:  `${UNS}/photo-1568252542512-9fe8fe9c87bb?w=800&q=80&auto=format&fit=crop`,
    beforeAlt: 'Retable avant restauration — dorure terne et boiseries dégradées',
    afterAlt: 'Retable après restauration — éclat restitué selon les prescriptions DRAC',
    caption: "Retable XVIIe, église Paris 14e — restauration en lien avec la DRAC, dorure à la feuille sur toutes les parties sculptées.",
  },
];

const categories = ['Tous', 'Cadre', 'Mobilier', "Objet d'art", 'Monument'];
---

<Layout
  title="Réalisations — Avant/Après · Atelier La Toison d'Or Paris 14"
  description="Galerie avant/après de l'atelier : restauration de cadres, mobilier, objets d'art et monuments historiques dorés à Paris 14e. Dorure à la feuille traditionnelle."
  canonical="/realisations"
>
  <Header slot="header" />

  <!-- Page header -->
  <section class="bg-lin py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="section-subtitle">Galerie</p>
      <h1 class="section-title max-w-xl mb-4">
        Ce que nos mains ont fait.
      </h1>
      <p class="font-sans text-anthracite/70 max-w-lg leading-relaxed">
        Glissez le curseur pour voir la restauration. Chaque pièce raconte une histoire — et un geste patient, au service de l'original.
      </p>
    </div>
  </section>

  <!-- Filter tabs -->
  <section class="bg-creme border-b border-lin sticky top-16 md:top-20 z-40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-1 overflow-x-auto py-3" id="filter-tabs">
        {categories.map((cat, i) => (
          <button
            data-filter={cat}
            class:list={[
              'filter-btn flex-shrink-0 font-sans text-sm px-4 py-2 rounded-sm transition-colors',
              i === 0
                ? 'bg-terracotta text-creme'
                : 'text-anthracite/60 hover:text-anthracite'
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery grid -->
  <section class="py-16 bg-creme">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="gallery-grid">
        {realisations.map(r => (
          <div data-category={r.category} class="gallery-item">
            <BeforeAfterSlider
              before={r.before}
              after={r.after}
              beforeAlt={r.beforeAlt}
              afterAlt={r.afterAlt}
              caption={r.caption}
              category={r.category}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter!;
      tabs.forEach(t => t.classList.remove('bg-terracotta', 'text-creme'));
      tab.classList.add('bg-terracotta', 'text-creme');
      items.forEach(item => {
        const show = filter === 'Tous' || item.dataset.category === filter;
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>
