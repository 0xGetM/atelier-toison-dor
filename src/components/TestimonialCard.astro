---
export interface Props {
  quote: string;
  author: string;
  detail?: string;
}
const { quote, author, detail } = Astro.props;
---

<figure class="content-card bg-lin/40 p-6 md:p-7 fade-up">
  <blockquote class="font-serif text-xl font-medium italic text-anthracite leading-snug mb-5">
    « {quote} »
  </blockquote>
  <figcaption class="font-sans text-sm text-terracotta font-bold">
    {author}
    {detail && <span class="text-anthracite/60 font-normal"> — {detail}</span>}
  </figcaption>
</figure>
